# Copiar a `.env` en la raíz del repo y completar. Nunca commitear `.env`.

# --- Solo desarrollo local ---
# Superusuario de Postgres. Lo usa únicamente `pnpm db:setup` para crear el rol y las bases.
POSTGRES_ADMIN_URL=postgresql://postgres:CAMBIAR_PASSWORD_POSTGRES@localhost:5432/postgres

# --- Base de datos ---
# En desarrollo DATABASE_URL y DIRECT_URL pueden ser la misma cadena.
# En producción (Neon): DATABASE_URL = conexión "pooled", DIRECT_URL = conexión directa (migraciones).
DATABASE_URL=postgresql://sch_app:sch_app_dev_password@localhost:5432/services_app_dev
DIRECT_URL=postgresql://sch_app:sch_app_dev_password@localhost:5432/services_app_dev
# Base separada para tests de integración (mismo rol, otra base).
TEST_DATABASE_URL=postgresql://sch_app:sch_app_dev_password@localhost:5432/services_app_test

# --- Auth (se usan a partir de las fases 2 y 4) ---
# Generar con: node -e "console.log(require('node:crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=CAMBIAR_POR_UN_SECRETO_LARGO_Y_ALEATORIO
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=CAMBIAR_PASSWORD_ADMIN

# --- Servidor ---
# Obligatoria: development | test | production (en Render: production).
NODE_ENV=development
# Orígenes permitidos por CORS, separados por coma.
CORS_ORIGIN=http://localhost:5173
PORT=3000
# Opcional: trace | debug | info | warn | error | fatal | silent
LOG_LEVEL=info
