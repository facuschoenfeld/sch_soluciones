# Copiar a `.env` en la raíz del repo y completar. Nunca commitear `.env`.

# --- Solo desarrollo local ---
# Superusuario de Postgres. Lo usa únicamente `pnpm db:setup` para crear el rol y las bases.
POSTGRES_ADMIN_URL=postgresql://postgres:CAMBIAR_PASSWORD_POSTGRES@localhost:5432/postgres

# --- Base de datos ---
# En desarrollo DATABASE_URL y DIRECT_URL pueden ser la misma cadena.
# En producción (Neon): DATABASE_URL = conexión "pooled", DIRECT_URL = conexión directa (migraciones).
# Elegí una contraseña propia para el rol sch_app (la crea `pnpm db:setup`) y usala en las tres URLs.
DATABASE_URL=postgresql://sch_app:CAMBIAR_PASSWORD_SCH_APP@localhost:5432/services_app_dev
DIRECT_URL=postgresql://sch_app:CAMBIAR_PASSWORD_SCH_APP@localhost:5432/services_app_dev
# Base separada para tests de integración (mismo rol, otra base).
TEST_DATABASE_URL=postgresql://sch_app:CAMBIAR_PASSWORD_SCH_APP@localhost:5432/services_app_test

# --- Auth ---
# Firma de las sesiones del panel (obligatoria, mínimo 43 caracteres). Generar con:
#   node -e "console.log(require('node:crypto').randomBytes(48).toString('base64url'))"
# Cambiarla cierra todas las sesiones abiertas.
JWT_SECRET=CAMBIAR_POR_UN_SECRETO_LARGO_Y_ALEATORIO
# Admin inicial: lo crea `pnpm db:seed` una sola vez (contraseña de al menos 12 caracteres).
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=CAMBIAR_PASSWORD_ADMIN

# --- Servidor ---
# Obligatoria: development | test | production (en Render: production).
NODE_ENV=development
# Origen del sitio, separados por coma si hay más de uno. Solo desde estos orígenes se aceptan
# escrituras en /api/auth y /api/admin (defensa CSRF). 5173 = `pnpm dev`, 4173 = `vite preview`.
# En producción: solo la URL https del sitio.
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:4173
PORT=3000
# Opcional: trace | debug | info | warn | error | fatal | silent
LOG_LEVEL=info
